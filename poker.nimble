version     = "0.1.0"
author      = "daveey"
description = "OS Poker: the imperfect-information ladder (Kuhn -> Leduc -> no-limit Hold'em) for the Softmax Coworld platform. A policy is just a prompt; cumulative net chips are the score."
license     = "MIT"

srcDir = "src"

requires "nim >= 2.2.4"
requires "bitworld >= 0.1.0"
requires "mummy >= 0.4.7"
requires "curly >= 1.1.1"
requires "whisky"
